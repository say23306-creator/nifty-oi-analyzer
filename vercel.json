{
  "regions": ["bom1"],
  "crons": [
    {
      "path": "/api/collect",
      "schedule": "*/3 3-10 * * 1-5"
    },
    {
      "path": "/api/cron/hourly-analysis",
      "schedule": "15 4-10 * * 1-5"
    }
  ],
  "functions": {
    "app/api/collect/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/hourly-analysis/route.ts": {
      "maxDuration": 60
    },
    "app/api/ai-analysis/route.ts": {
      "maxDuration": 45
    },
    "app/api/telegram/webhook/route.ts": {
      "maxDuration": 15
    }
  }
}
